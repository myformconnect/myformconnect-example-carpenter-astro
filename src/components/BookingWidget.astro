---
// BookingWidget.astro
import FormAttribution from './FormAttribution.astro';

interface Props {
  showBubble?: boolean;
}

const { showBubble = true } = Astro.props;
---

<!-- Floating Consultation Bubble Trigger -->
{showBubble && (
  <div class="booking-bubble-container" id="booking-bubble-root">
    <button
      type="button"
      class="booking-bubble-btn"
      data-booking-popup
      aria-label="Reserve a consultation slot with our master carpenter"
      title="Reserve a Consultation Slot"
    >
      <span class="bubble-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
          <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/>
        </svg>
      </span>
      <span class="bubble-pill-label">Reserve a Slot</span>
    </button>
  </div>
)}

<!-- Booking Popup Modal Overlay -->
<div id="booking-popup-overlay" class="mfc-booking-popup" hidden aria-hidden="true" role="dialog" aria-modal="true">
  <div class="mfc-booking-popup-backdrop" data-booking-popup-close tabindex="-1"></div>
  <div class="mfc-booking-popup-panel">
    <button
      type="button"
      class="mfc-booking-popup-close"
      data-booking-popup-close
      aria-label="Close consultation modal"
      title="Close"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="1" y1="1" x2="13" y2="13"></line>
        <line x1="13" y1="1" x2="1" y2="13"></line>
      </svg>
    </button>
    
    <div class="booking-modal-layout">
      <!-- Left Column: Rich Editorial Consultation Context -->
      <aside class="booking-modal-sidebar">
        <div>
          <div class="modal-sidebar-badge">
            <span class="badge-dot"></span>
            <span>Oakline Workshop &bull; Portland Studio</span>
          </div>
          
          <h3 class="modal-sidebar-title">Book Your 1-on-1 Consultation</h3>
          
          <p class="modal-sidebar-desc">
            Reserve a 30-minute consultation with our master craftsman to plan your custom furniture, built-in cabinetry, or bespoke woodwork.
          </p>

          <div class="modal-features-list">
            <div class="modal-feature-item">
              <div class="feature-icon" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                </svg>
              </div>
              <div class="feature-text">
                <strong>Review Dimensions &amp; Blueprints</strong>
                <span>Bring sketches, photos, or architectural plans for immediate feedback.</span>
              </div>
            </div>

            <div class="modal-feature-item">
              <div class="feature-icon" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </div>
              <div class="feature-text">
                <strong>Timber &amp; Finish Recommendations</strong>
                <span>Explore sustainably harvested White Oak, Walnut, Maple, and natural oils.</span>
              </div>
            </div>

            <div class="modal-feature-item">
              <div class="feature-icon" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <div class="feature-text">
                <strong>Transparent Pricing &amp; Timeline</strong>
                <span>Receive realistic fabrication schedules and an itemized cost estimate.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-meta-pills">
          <span class="meta-pill">⏱ 30-Minute Meeting</span>
          <span class="meta-pill">📍 Phone / Video Call</span>
          <span class="meta-pill highlight-pill">✓ Complimentary</span>
        </div>
      </aside>

      <!-- Right Column: Compact Booking Widget Container -->
      <div class="booking-modal-main">
        <div class="booking-widget-wrapper">
          <div
            data-booking-widget
            data-submit-url="https://myformcapture.com/f/b3587e76-5943-48ae-8bbc-92b08a2e7876"
            data-slots-url="https://myformcapture.com/f/b3587e76-5943-48ae-8bbc-92b08a2e7876/slots"
            data-form-uuid="b3587e76-5943-48ae-8bbc-92b08a2e7876"
            data-api-base="https://myformcapture.com"
            data-meeting-title="Custom Carpentry Consultation"
            data-meeting-description="Discuss your custom woodworking project, design ideas, measurements, materials and requirements."
            data-meeting-duration="30"
          ></div>

          <FormAttribution />
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Local Styled Booking Widget CSS & Official Widget Script with Local Fallback -->
<link rel="stylesheet" href="/booking-widget.css" />
<script is:inline src="https://myformconnect.io/booking-widget.js" onerror="this.onerror=null;var s=document.createElement('script');s.src='/booking-widget.js';document.head.appendChild(s);"></script>

<style>
  /* Floating Booking Bubble */
  .booking-bubble-container {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }

  .booking-bubble-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background-color: var(--color-wood);
    color: var(--color-white);
    border: none;
    border-radius: 9999px;
    padding: 0.75rem 1.15rem;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(35, 37, 34, 0.22);
    transition: all var(--transition);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .booking-bubble-btn:hover {
    background-color: var(--color-wood-dark);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(35, 37, 34, 0.28);
  }

  .bubble-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bubble-pill-label {
    white-space: nowrap;
  }

  /* Modal Wrapper & Panel */
  .mfc-booking-popup {
    padding: 1.25rem;
  }

  .mfc-booking-popup-panel {
    background-color: var(--color-white);
    border-radius: 6px;
    padding: 0;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
    max-width: 880px;
    width: 100%;
    overflow: hidden;
    position: relative;
    border: 1px solid var(--color-border);
  }

  .mfc-booking-popup-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 30;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background-color: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    outline: none;
    line-height: 0;
    transition: all var(--transition);
    appearance: none;
    -webkit-appearance: none;
    box-sizing: border-box;
  }

  .mfc-booking-popup-close svg {
    display: block;
    width: 14px;
    height: 14px;
    pointer-events: none;
    transition: transform var(--transition);
  }

  .mfc-booking-popup-close:hover {
    background-color: var(--color-bg-dark);
    color: var(--color-white);
    border-color: var(--color-bg-dark);
    transform: scale(1.05);
  }

  .mfc-booking-popup-close:hover svg {
    transform: rotate(90deg);
  }

  /* 2-Column Modal Layout */
  .booking-modal-layout {
    display: grid;
    grid-template-columns: 350px 1fr;
    min-height: 480px;
  }

  /* Left Editorial Sidebar */
  .booking-modal-sidebar {
    background-color: var(--color-bg-dark);
    color: var(--color-text-light);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid var(--color-border-dark);
  }

  .modal-sidebar-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-wood-light);
    margin-bottom: 0.85rem;
  }

  .modal-sidebar-badge .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-wood);
  }

  .modal-sidebar-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-white);
    margin-bottom: 0.65rem;
  }

  .modal-sidebar-desc {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: #C7C5BF;
    margin-bottom: 1.5rem;
  }

  .modal-features-list {
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .modal-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .modal-feature-item .feature-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--color-wood-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .modal-feature-item .feature-text strong {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-white);
    line-height: 1.3;
    margin-bottom: 0.15rem;
  }

  .modal-feature-item .feature-text span {
    display: block;
    font-size: 0.75rem;
    line-height: 1.4;
    color: #A3A29D;
  }

  .modal-meta-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 1.15rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .modal-meta-pills .meta-pill {
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.08);
    color: #E2E0D8;
  }

  .modal-meta-pills .highlight-pill {
    background-color: rgba(164, 119, 77, 0.22);
    color: var(--color-wood-light);
    border: 1px solid rgba(164, 119, 77, 0.4);
  }

  /* Right Main Content Column */
  .booking-modal-main {
    background-color: var(--color-white);
    padding: 1.5rem 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .booking-widget-wrapper {
    width: 100%;
  }

  @media (max-width: 800px) {
    .mfc-booking-popup-panel {
      max-width: 460px;
      max-height: 90vh;
      overflow-y: auto;
    }

    .booking-modal-layout {
      grid-template-columns: 1fr;
    }

    .booking-modal-sidebar {
      padding: 1.5rem 1.25rem 1.25rem;
      border-right: none;
      border-bottom: 1px solid var(--color-border-dark);
    }

    .booking-modal-sidebar .modal-features-list {
      display: none;
    }

    .modal-sidebar-desc {
      margin-bottom: 1rem;
    }

    .booking-modal-main {
      padding: 1.25rem 1rem;
    }
  }

  @media (max-width: 600px) {
    .booking-bubble-container {
      bottom: 1rem;
      right: 1rem;
    }

    .booking-bubble-btn {
      padding: 0.75rem;
      border-radius: 50%;
      width: 48px;
      height: 48px;
      justify-content: center;
    }

    .bubble-pill-label {
      display: none;
    }
  }
</style>
