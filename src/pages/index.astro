---
// index.astro - Oakline Workshop Home Page
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featuredProjects = [
  {
    title: 'Solid Oak Dining Table',
    category: 'Custom Furniture',
    description: 'Quarter-sawn American white oak featuring traditional mortise-and-tenon joinery and an organic hardwax-oil matte finish.',
    imageUrl: '/images/Solid_Oak_Dining_Table.avif',
    materials: 'American White Oak',
    year: '2025',
  },
  {
    title: 'Custom Built-in Wardrobe',
    category: 'Built-in Wardrobes',
    description: 'Floor-to-ceiling master wardrobe with integrated soft-close linen drawers, recessed brass pull handles, and internal LED channels.',
    imageUrl: '/images/Custom_Built-in_Wardrobe.jpeg',
    materials: 'White Ash & Brass',
    year: '2025',
  },
  {
    title: 'Minimalist Kitchen Cabinetry',
    category: 'Kitchen Cabinetry',
    description: 'Bespoke flat-panel kitchen cabinetry with grain-matched drawer fronts, hidden finger pulls, and natural moisture-resistant seals.',
    imageUrl: '/images/Minimalist_Kitchen_Cabinetry.webp',
    materials: 'Select Walnut & Birch Core',
    year: '2024',
  },
  {
    title: 'Wooden Interior Feature Wall',
    category: 'Interior Woodwork',
    description: 'Acoustic slatted timber wall installation for a modern living pavilion, crafted with hand-selected Douglas fir slats on black acoustic felt.',
    imageUrl: '/images/Wooden_Interior_Feature_Wall.jpeg',
    materials: 'Pacific Douglas Fir',
    year: '2024',
  },
];

const reviews = [
  {
    author: 'Arthur & Sarah Pendelton',
    location: 'Portland, OR',
    project: 'Bespoke 10-Seater White Oak Dining Table',
    quote: 'Julian and the team created an heirloom piece that completely redefined our home. The grain selection is breathtaking, and the mortise-and-tenon joinery is so tight you can barely feel the seams. Delivered on schedule with immense care.',
    date: 'October 2025',
  },
  {
    author: 'Elena Rostova',
    location: 'West Hills, OR',
    project: 'Floor-to-Ceiling Built-in Wardrobes',
    quote: 'As an architect, I am notoriously demanding about millimeter tolerances. Oakline’s craftsmanship was second to none. The internal drawers slide silently, and the cedar backing adds an incredible aroma. Truly bespoke woodwork.',
    date: 'December 2025',
  },
  {
    author: 'Marcus Thorne',
    location: 'Hearth & Wood Café, Portland',
    project: 'Commercial Fluted Timber Service Counter',
    quote: 'Our café service bar takes heavy traffic every single morning. Six months in, the custom oak counter looks just as stunning as day one. The finish is resilient, wire channels are completely hidden, and customers compliment it daily.',
    date: 'August 2025',
  },
  {
    author: 'David & Karen Chen',
    location: 'Lake Oswego, OR',
    project: 'Minimalist Kitchen Cabinetry & Floating Shelves',
    quote: 'From initial 3D plans to final installation, communication was transparent and reassuring. Seeing the continuous grain run across every single cabinet drawer is a daily joy. Worth every penny.',
    date: 'November 2025',
  },
];

const servicePreviews = [
  {
    title: 'Custom Furniture',
    desc: 'Dining tables, desks, coffee tables, and heirloom freestanding pieces designed for daily life.',
    icon: 'M4 6h16M4 12h16M7 18h10',
    href: '/services#custom-furniture',
  },
  {
    title: 'Built-in Wardrobes',
    desc: 'Full-height closet suites, alcove storage, and dressing spaces tailored to exact room dimensions.',
    icon: 'M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm7 0v18',
    href: '/services#builtin-wardrobes',
  },
  {
    title: 'Kitchen Cabinetry',
    desc: 'Precision cabinetry, solid drawer boxes, pantry architecture, and bespoke island features.',
    icon: 'M3 5h18v14H3V5zm0 5h18',
    href: '/services#kitchen-cabinetry',
  },
  {
    title: 'Shelving & Storage',
    desc: 'Floating shelves, modular bookcases, record storage, and integrated alcove display units.',
    icon: 'M3 4h18M3 10h18M3 16h18M3 20h18',
    href: '/services#shelving-storage',
  },
  {
    title: 'Interior Woodwork',
    desc: 'Custom interior doors, architectural paneling, coffered ceilings, and refined timber moldings.',
    icon: 'M4 4h16v16H4V4zm4 0v16',
    href: '/services#interior-woodwork',
  },
  {
    title: 'Commercial Woodwork',
    desc: 'Specialty counters, reception desks, conference tables, and retail displays for distinctive brands.',
    icon: 'M3 7h18M3 12h18M6 17h12',
    href: '/services#commercial-woodwork',
  },
  {
    title: 'Furniture Restoration',
    desc: 'Structural joinery repair, surface refinishing, veneer restoration, and historic conservation.',
    icon: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
    href: '/services#furniture-restoration',
  },
];

const processSteps = [
  {
    step: '01',
    title: 'Discuss Your Ideas',
    desc: 'We begin with an open conversation regarding your space, functional needs, visual references, and timeline expectations.',
  },
  {
    step: '02',
    title: 'Design & Planning',
    desc: 'We translate your brief into scaled drawings, 3D renderings, and detailed construction joinery specifications.',
  },
  {
    step: '03',
    title: 'Material Selection',
    desc: 'We inspect and select lumber based on grain continuity, structural character, moisture balance, and sustainable origins.',
  },
  {
    step: '04',
    title: 'Craftsmanship',
    desc: 'Every joint is cut, planed, fitted, and finished by hand inside our workshop using proven traditional and modern techniques.',
  },
  {
    step: '05',
    title: 'Installation & Finishing',
    desc: 'Our craftsmen handle on-site delivery and precision installation, leaving your space clean and your piece perfectly set.',
  },
];
---

<MainLayout
  title="Fine Woodworking & Custom Carpentry"
  description="Oakline Workshop designs and crafts bespoke furniture, built-in wardrobes, kitchen cabinetry, and interior woodwork built to last generations."
  currentPath="/"
>
  <!-- Hero Section -->
  <Hero />

  <!-- Introduction Section -->
  <section class="section intro-section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-left">
          <p class="eyebrow">The Oakline Philosophy</p>
          <h2 class="intro-headline">
            Good craftsmanship starts with the details.
          </h2>
        </div>

        <div class="intro-right">
          <p class="lead">
            Oakline Workshop creates custom woodworking solutions tailored to our clients' spaces, requirements, and lifestyles.
          </p>
          <p>
            Whether it is an 8-seater dining table destined to anchor family meals for decades, or custom architectural joinery fitted flush to an uneven historic wall, we believe that honest timber, thoughtful proportion, and meticulous joinery elevate any interior.
          </p>
          <p>
            Every piece is cut, planed, and finished in our studio. We source our timber from certified domestic forestry partners who practice sustainable harvesting, ensuring that each grain tells a story of longevity and respect for the material.
          </p>
          <div class="intro-quote">
            <blockquote>
              &ldquo;We don't manufacture furniture in mass batches. We craft singular pieces that belong nowhere else but your home.&rdquo;
            </blockquote>
            <cite>&mdash; Julian Vance, Founder &amp; Master Woodworker</cite>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Preview Section -->
  <section class="section bg-alt services-preview-section">
    <div class="container">
      <div class="section-header-row">
        <div>
          <p class="eyebrow">What We Build</p>
          <h2>Custom Woodworking Services</h2>
        </div>
        <a href="/services" class="btn btn-outline view-all-link">
          View All Services &amp; Details
        </a>
      </div>

      <div class="services-grid">
        {servicePreviews.map((service) => (
          <div class="service-card">
            <h3 class="service-card-title">{service.title}</h3>
            <p class="service-card-desc">{service.desc}</p>
            <a href={service.href} class="btn-link service-card-link">
              Explore {service.title}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="section featured-projects-section">
    <div class="container">
      <div class="section-header-row">
        <div>
          <p class="eyebrow">Portfolio Highlights</p>
          <h2>Featured Workshop Projects</h2>
        </div>
        <a href="/projects" class="btn btn-outline view-all-link">
          Explore All Projects
        </a>
      </div>

      <div class="projects-grid">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.title}
            category={project.category}
            description={project.description}
            imageUrl={project.imageUrl}
            materials={project.materials}
            year={project.year}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="section bg-dark process-section">
    <div class="container">
      <div class="process-header">
        <p class="eyebrow">Our Working Methodology</p>
        <h2>How We Work With You</h2>
        <p class="process-sub lead">
          From the first sketch to final installation, our process is transparent, structured, and focused on exceptional execution.
        </p>
      </div>

      <div class="process-grid">
        {processSteps.map((step) => (
          <div class="process-step-card">
            <span class="step-num">{step.step}</span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Client Reviews / Testimonials Section -->
  <section class="section reviews-section">
    <div class="container">
      <div class="section-header-row">
        <div>
          <p class="eyebrow">Client Testimonials</p>
          <h2>Crafted With Care, Proven in Daily Life</h2>
        </div>
        <div class="reviews-summary-badge">
          <div class="rating-stars" aria-label="5 out of 5 stars">
            ★★★★★
          </div>
          <span class="rating-score">4.9 / 5.0</span>
          <span class="rating-count">(60+ Commissions)</span>
        </div>
      </div>

      <div class="reviews-grid">
        {reviews.map((review) => (
          <div class="review-card">
            <div class="review-stars" aria-hidden="true">★★★★★</div>
            <p class="review-project">{review.project}</p>
            <blockquote class="review-quote">
              &ldquo;{review.quote}&rdquo;
            </blockquote>
            <div class="review-author-wrap">
              <div class="author-avatar" aria-hidden="true">
                {review.author.slice(0, 1)}
              </div>
              <div class="author-details">
                <span class="author-name">{review.author}</span>
                <span class="author-meta">{review.location} &bull; {review.date}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="section cta-section">
    <div class="container-narrow text-center">
      <p class="eyebrow">Start Your Commission</p>
      <h2 class="cta-title">Have something in mind? Let's build it.</h2>
      <p class="cta-desc lead">
        Whether you have detailed architectural blueprints or a rough napkin sketch, we are ready to discuss your custom project.
      </p>
      <div class="cta-actions">
        <a href="/quote" class="btn btn-primary btn-lg">
          Request Your Project Quote
        </a>
        <a href="/quote#booking-section" data-booking-popup class="btn btn-outline btn-lg">
          Book a 30-Min Consultation
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Intro Section */
  .intro-section {
    border-bottom: 1px solid var(--color-border);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 5rem;
    align-items: flex-start;
  }

  .intro-headline {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    line-height: 1.15;
    position: sticky;
    top: 120px;
  }

  .intro-quote {
    margin-top: 2.5rem;
    padding: 1.75rem 2rem;
    background-color: var(--color-bg-alt);
    border-left: 3px solid var(--color-wood);
    border-radius: var(--radius-sm);
  }

  .intro-quote blockquote {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--color-text);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .intro-quote cite {
    font-size: 0.875rem;
    color: var(--color-wood-dark);
    font-weight: 600;
    font-style: normal;
  }

  /* Section Header Row */
  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3.5rem;
    gap: 2rem;
  }

  /* Services Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .service-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .service-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(35, 37, 34, 0.05);
  }

  .service-card-title {
    font-size: 1.45rem;
    margin-bottom: 0.75rem;
  }

  .service-card-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .service-card-link {
    margin-top: auto;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  /* Process Section */
  .process-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 4.5rem;
  }

  .process-sub {
    color: #A3A29D !important;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }

  .process-step-card {
    background-color: #2D302C;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-sm);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .step-num {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    color: var(--color-wood-light);
    line-height: 1;
    margin-bottom: 1.25rem;
  }

  .step-title {
    font-size: 1.25rem;
    color: var(--color-white);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .step-desc {
    font-size: 0.875rem;
    color: #A3A29D !important;
    line-height: 1.55;
    margin: 0;
  }

  /* CTA Section */
  .cta-section {
    padding-top: var(--spacing-3xl);
    padding-bottom: var(--spacing-3xl);
    background-color: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
  }

  .text-center {
    text-align: center;
  }

  .cta-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-bottom: 1.25rem;
  }

  .cta-desc {
    margin: 0 auto 2.5rem;
    max-width: 620px;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .btn-lg {
    padding: 1.1rem 2.25rem;
    font-size: 1.05rem;
  }

  /* Reviews Section */
  .reviews-section {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .reviews-summary-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .rating-stars {
    color: var(--color-wood);
    letter-spacing: 2px;
    font-size: 0.95rem;
  }

  .rating-score {
    font-weight: 700;
    color: var(--color-text);
  }

  .rating-count {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .review-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .review-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(35, 37, 34, 0.05);
  }

  .review-stars {
    color: var(--color-wood);
    font-size: 1rem;
    letter-spacing: 2px;
    margin-bottom: 0.75rem;
  }

  .review-project {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-wood-dark);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .review-quote {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 1.75rem;
    font-style: italic;
    flex-grow: 1;
  }

  .review-author-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--color-wood-dark);
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .author-meta {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  /* Responsive */
  @media (max-width: 1080px) {
    .process-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 860px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .intro-headline {
      position: static;
    }

    .section-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .reviews-grid {
      grid-template-columns: 1fr;
    }

    .process-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .cta-actions {
      flex-direction: column;
    }

    .cta-actions .btn {
      width: 100%;
    }
  }
</style>
