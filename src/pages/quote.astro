---
// quote.astro - Oakline Workshop Project Quote & Consultation
import MainLayout from '../layouts/MainLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
---

<MainLayout
  title="Request a Quote & Consultation"
  description="Request a custom woodworking quote or schedule a 1-on-1 consultation with Oakline Workshop for custom furniture, built-ins, and cabinetry."
  currentPath="/quote"
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <div class="header-content">
        <p class="eyebrow">Project Commissioning</p>
        <h1 class="page-title">Request a Project Quote</h1>
        <p class="page-lead lead">
          Every custom piece begins with your vision. Share your dimensions, timber preferences, and timeline below, or open our consultation scheduler to book a 30-minute design session directly with our craft team.
        </p>
      </div>

      <!-- Quick Switcher Bar -->
      <div class="quote-options-bar">
        <span class="switcher-label">Options:</span>
        <div class="switcher-links">
          <a href="#quote-form" class="switcher-pill is-primary">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2.5 3.5h11v9h-11z" stroke="currentColor" stroke-width="1.3"/>
              <path d="M5 6.5h6M5 9.5h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            Submit Project Details &amp; Budget
          </a>
          <button type="button" class="switcher-pill switcher-btn" data-booking-popup>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="2.5" y="3.5" width="11" height="10" rx="1" stroke="currentColor" stroke-width="1.3"/>
              <path d="M2.5 6.5h11M5.5 2v3M10.5 2v3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            Reserve a 30-Min Craftsman Slot
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote Process & Guidelines Banner -->
  <section class="section-sm bg-alt guidelines-section">
    <div class="container">
      <div class="guidelines-grid">
        <div class="guideline-item">
          <span class="guide-num">01</span>
          <div class="guide-body">
            <h4>Itemized Estimates</h4>
            <p>We review your dimensions and provide a transparent quote detailing material costs and joinery labor within 2 business days.</p>
          </div>
        </div>
        <div class="guideline-item">
          <span class="guide-num">02</span>
          <div class="guide-body">
            <h4>Lumber Sourcing</h4>
            <p>We work exclusively with sustainably harvested American hardwoods, hand-selecting boards for grain match and stability.</p>
          </div>
        </div>
        <div class="guideline-item">
          <span class="guide-num">03</span>
          <div class="guide-body">
            <h4>Site Measuring</h4>
            <p>For fitted wardrobes, cabinetry, and feature walls, we conduct in-person precision laser measuring prior to cutting.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Quote Layout -->
  <div class="quote-layout-section">
    <div class="container">
      <div class="quote-grid">
        <!-- Main Form Column: Quote Form Only (no empty right space!) -->
        <div class="forms-column">
          <section id="quote-form" class="quote-block">
            <QuoteForm />
          </section>

          <!-- Compact Consultation Callout Banner -->
          <div class="consultation-callout-card">
            <div class="callout-icon-box" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
            </div>
            <div class="callout-content">
              <p class="eyebrow">1-on-1 Design Meeting</p>
              <h3>Prefer to discuss your project directly?</h3>
              <p>Schedule a 30-minute consultation with our master woodworker to review architectural drawings, timber finishes, or room dimensions.</p>
              <div class="callout-actions">
                <button type="button" class="btn btn-dark" data-booking-popup>
                  Reserve Your Consultation Slot &rarr;
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar Guide Column -->
        <aside class="sidebar-column">
          <div class="sticky-box">
            <div class="sidebar-card">
              <h4 class="card-heading">What to Include in Your Quote</h4>
              <ul class="checklist">
                <li>
                  <strong>Room Context:</strong> Dining room, master alcove, kitchen island, etc.
                </li>
                <li>
                  <strong>Dimensions:</strong> Approximate width, height, and depth (e.g. 96" L &times; 42" W &times; 30" H).
                </li>
                <li>
                  <strong>Preferred Timber:</strong> White oak, walnut, maple, ash, or douglas fir.
                </li>
                <li>
                  <strong>Special Features:</strong> Integrated cable routing, brass hardware, soft-close drawers, or extending leaves.
                </li>
              </ul>
            </div>

            <div class="sidebar-card assistance-card">
              <h4 class="card-heading">Need Quick Assistance?</h4>
              <p>For general inquiries or to check workshop availability, feel free to contact us directly:</p>
              <p class="direct-contact">
                <strong>Phone:</strong> <a href="tel:+15035550184">(503) 555-0184</a><br />
                <strong>Email:</strong> <a href="mailto:quotes@oaklineworkshop.com">quotes@oaklineworkshop.com</a>
              </p>
              <a href="/contact" class="btn btn-outline btn-sm">
                Go to General Contact Page &rarr;
              </a>
            </div>

            <div class="workshop-mini-photo">
              <img
                src="/images/hero_image.webp"
                alt="Oakline Workshop craftsman planing solid hardwood"
                class="img-cover"
                loading="lazy"
              />
              <span class="photo-caption">Bay 1 Workbench &bull; Hand-planed white oak</span>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .page-header {
    padding-top: var(--spacing-2xl);
    padding-bottom: var(--spacing-xl);
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .header-content {
    max-width: 820px;
    margin-bottom: 2rem;
  }

  .page-title {
    margin-bottom: 1.25rem;
  }

  /* Switcher Bar */
  .quote-options-bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .switcher-label {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .switcher-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .switcher-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    padding: 0.55rem 1.15rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    transition: all var(--transition);
    cursor: pointer;
    font-family: inherit;
  }

  .switcher-pill:hover,
  .switcher-pill.is-primary {
    background-color: var(--color-wood);
    color: var(--color-white);
    border-color: var(--color-wood);
  }

  .switcher-btn {
    border: 1px solid var(--color-border);
    background-color: var(--color-white);
  }

  /* Guidelines Grid */
  .guidelines-section {
    border-bottom: 1px solid var(--color-border);
  }

  .guidelines-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .guideline-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .guide-num {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--color-wood);
    line-height: 1;
  }

  .guide-body h4 {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .guide-body p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* Main Layout */
  .quote-layout-section {
    padding-top: var(--spacing-2xl);
    padding-bottom: var(--spacing-3xl);
  }

  .quote-grid {
    display: grid;
    grid-template-columns: 1.65fr 1fr;
    gap: 3.5rem;
    align-items: flex-start;
  }

  .forms-column {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .quote-block {
    scroll-margin-top: 100px;
  }

  /* Consultation Callout Card */
  .consultation-callout-card {
    display: flex;
    gap: 1.5rem;
    padding: 2.25rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-wood);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 20px rgba(35, 37, 34, 0.03);
  }

  .callout-icon-box {
    color: var(--color-wood);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .callout-content h3 {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .callout-content p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .callout-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }


  /* Sidebar */
  .sticky-box {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .sidebar-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(35, 37, 34, 0.03);
  }

  .card-heading {
    font-size: 1.15rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .checklist li {
    position: relative;
    padding-left: 1.35rem;
    color: var(--color-text-muted);
  }

  .checklist li strong {
    color: var(--color-text);
  }

  .checklist li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-wood);
    font-weight: 700;
  }

  .assistance-card p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .direct-contact {
    margin-bottom: 1.25rem !important;
  }

  .direct-contact a {
    color: var(--color-wood);
    text-decoration: underline;
  }

  .btn-sm {
    padding: 0.65rem 1.25rem;
    font-size: 0.85rem;
    display: inline-flex;
  }

  .workshop-mini-photo {
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border);
    position: relative;
    aspect-ratio: 16 / 10;
  }

  .photo-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(35, 37, 34, 0.85), transparent);
    padding: 0.75rem;
    color: #F5F3EE;
    font-size: 0.75rem;
  }

  @media (max-width: 960px) {
    .guidelines-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .quote-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .sticky-box {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .consultation-callout-card {
      flex-direction: column;
      padding: 1.5rem;
    }
  }
</style>
