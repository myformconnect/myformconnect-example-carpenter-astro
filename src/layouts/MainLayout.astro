---
// MainLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingWidget from '../components/BookingWidget.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Oakline Workshop — Professional carpentry and custom woodworking. Built with purpose. Crafted to last.',
  currentPath = '/',
  ogImage = '/images/og-image.jpg',
} = Astro.props;

const siteUrl = 'https://oaklineworkshop.vercel.app';
const canonicalURL = new URL(currentPath, siteUrl).href;
const fullTitle = currentPath === '/' ? `${title} — Oakline Workshop` : `${title} | Oakline Workshop`;
const absoluteOgImage = new URL(ogImage, siteUrl).href;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  'name': 'Oakline Workshop',
  'description': description,
  'url': siteUrl,
  'telephone': '+1-503-555-0142',
  'email': 'hello@oaklineworkshop.com',
  'image': absoluteOgImage,
  'priceRange': '$$$',
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': '1428 SE Industrial Way, Suite 4',
    'addressLocality': 'Portland',
    'addressRegion': 'OR',
    'postalCode': '97214',
    'addressCountry': 'US'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': 45.5152,
    'longitude': -122.6587
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      'opens': '08:00',
      'closes': '17:00'
    },
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': 'Saturday',
      'opens': '09:00',
      'closes': '14:00'
    }
  ],
  'sameAs': [
    siteUrl
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#232522" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Oakline Workshop" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Oakline Workshop — Fine Woodworking & Bespoke Carpentry" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content="Oakline Workshop — Fine Woodworking & Bespoke Carpentry" />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />

    <!-- Google Fonts: Playfair Display for editorial headings -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <BookingWidget />
  </body>
</html>
